{
  "name": "open-cs-labs",
  "version": "0.0.0",
  "private": true,
  "description": "Open CS Labs monorepo. M0 foundation stage: tooling and configuration only.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.1",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write \"**/*.{json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{json,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
