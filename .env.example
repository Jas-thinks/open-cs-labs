# Open CS Labs — local development environment template.
#
# Copy this file to `.env` and fill in local values:
#     cp .env.example .env
#
# `.env` is git-ignored and must never be committed with real credentials.
# Only placeholder values belong in this file (see RULES.md section 4).

# --- Local PostgreSQL (provided by docker-compose from M1 onward) ---
POSTGRES_USER=open_cs_labs
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=open_cs_labs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://open_cs_labs:local-dev-only@localhost:5432/open_cs_labs

# --- Application security (used from M1 onward) ---
# Generate a local value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=local-dev-only
# Set to true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite, from M1 onward) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Proposed, not yet implemented (M4/M5) ---
# Names below are recorded so they are not invented later; no code reads them yet.
# REDIS_URL=redis://localhost:6379/0
# JUDGE_URL=http://localhost:2358
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=local-dev-only
# S3_SECRET_KEY=local-dev-only
# LLM_API_KEY=local-dev-only
